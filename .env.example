# --- Источник (Comdi) ---
COMDI_EVENT_URL=https://broadcast.comdi.com/api/player/event/erzo3310

# --- Приёмник (Eventicious External API v2) ---
EVENTICIOUS_BASE_URL=https://api-integration.eventicious.ru
EVENTICIOUS_CLIENT_ID=cl-21-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EVENTICIOUS_CLIENT_SECRET=cs-21-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Часовой пояс события: время в Comdi приходит unix-UTC, а в Eventicious — локальное.
EVENT_TIMEZONE=Europe/Moscow

# --- Поведение синхронизации ---
# интервал опроса, сек
SYNC_INTERVAL_SECONDS=300
# удалять из Eventicious то, чего больше нет в Comdi
DELETE_REMOVED=true
# синхронизировать английскую версию (title/description -> language=en-US)
SYNC_EN=true
# базовые смещения ID, чтобы id из Comdi не пересеклись с уже существующими в Eventicious
ID_OFFSET_LOCATION=100000
ID_OFFSET_TAG=200000
ID_OFFSET_SESSION=300000
ID_OFFSET_USER=400000

# локальное состояние (маппинг ID + контрольные суммы)
STATE_DB=sync_state.sqlite3
LOG_LEVEL=INFO

# --- Telegram-уведомления о сбоях (пусто = выключены) ---
# бот от @BotFather, chat_id — например, через @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# не чаще, чем раз в N часов повторять уведомление об одной и той же ошибке
ALERT_COOLDOWN_HOURS=6
